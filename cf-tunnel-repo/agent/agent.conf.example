# ============================================================================
# agent.conf — tunnel-agent 唯一需要修改的文件
# 复制为 agent.conf 后 chmod 600 agent.conf
# 换服务器时：只改下面 NODE_ID 一处，其余照抄即可。
# ============================================================================

# ---------- 必填 ----------

# 这台机器的名字，只用于日志与多机区分。不含空格。
NODE_ID="jp-nat1"

# 你的 Pages / Worker 地址，末尾不要带斜杠
API_BASE="https://your-project.pages.dev"

# 与 Worker 环境变量 REPORT_TOKEN 完全一致
REPORT_TOKEN="paste-your-report-token-here"

# ---------- 后端（通常是唯一需要按机器调整的一项）----------

# auto = 自动探测 127.0.0.1 上的 vless/ws 后端端口（匹配 sing-box/xray 进程）
# 也可以直接写死端口，例如 BACKEND_PORT="44615"
BACKEND_PORT="auto"

# 探测时排除的端口（nginx / 面板 / 监控）
PORT_BLACKLIST="8080 8443 9090 80 443"

# 探测时优先匹配的进程名
PROC_HINTS="sing-box xray v2ray hysteria"

# ---------- 隧道参数 ----------

# http2 最稳；想走 UDP 改 quic（部分网络封 UDP 会失败）
CF_PROTOCOL="http2"

# 4 或 6，指定 cloudflared 连接的 edge IP 版本
CF_EDGE_IP="4"

# 可选：强制落地区域，留空为自动（常见值 hkg / nrt / sin / lax）
CF_REGION=""

# cloudflared 可执行文件路径
CF_BIN="cloudflared"

# 本机 metrics 端口，多台机器同机部署时要错开
METRICS_PORT="20241"

# ---------- 轮换策略 ----------

# 隧道最长存活秒数，到点自动换新的。默认 259200 = 3 天
MAX_TUNNEL_AGE="259200"

# 等待 cloudflared 输出域名的超时秒数
HOST_WAIT_SECONDS="80"

# 状态与日志目录
STATE_DIR="/var/lib/tunnel-agent"
